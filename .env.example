# Supabase Configuration (Required for API routes and server components)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Paystack Configuration (Required for payment processing)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
PAYSTACK_SECRET_KEY=your_paystack_secret_key
# Identifier in metadata; one signed webhook can serve multiple sites.
PAYSTACK_SITE_ID=babybags

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Configuration (Optional - set by Vercel automatically)
VERCEL_OIDC_TOKEN=your_vercel_oidc_token
